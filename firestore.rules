rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Usuários ─────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      // Impede escalonamento de privilégios: isAdmin e isVerified só são escritos pelo console/admin SDK
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isVerified', 'uid']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── Posts ────────────────────────────────────────────────────
    match /posts/{postId} {
      // public/friends: qualquer autenticado; private: só autor.
      // Usa get() com default 'public' para posts antigos sem campo privacy.
      allow read: if request.auth != null
        && (resource.data.get('privacy', 'public') in ['public', 'friends']
            || resource.data.authorId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      // Autor pode editar o próprio post, mas não pode alterar campos de moderação
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['modStatus', 'modReason', 'modCategories', 'modAt', 'modSource']);
      // Admin pode atualizar status de moderação
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['modStatus', 'modReason', 'modCategories', 'modAt'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      // Qualquer usuário pode adicionar/remover apenas seu próprio UID em likes
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && (
          (request.auth.uid in request.resource.data.likes
           && !(request.auth.uid in resource.data.likes)
           && request.resource.data.likes.size() == resource.data.likes.size() + 1)
          ||
          (!(request.auth.uid in request.resource.data.likes)
           && request.auth.uid in resource.data.likes
           && request.resource.data.likes.size() == resource.data.likes.size() - 1)
        );
      // Qualquer usuário pode adicionar/remover apenas seu próprio UID em bookmarks
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookmarks'])
        && (
          (request.auth.uid in request.resource.data.bookmarks
           && !(request.auth.uid in resource.data.bookmarks)
           && request.resource.data.bookmarks.size() == resource.data.bookmarks.size() + 1)
          ||
          (!(request.auth.uid in request.resource.data.bookmarks)
           && request.auth.uid in resource.data.bookmarks
           && request.resource.data.bookmarks.size() == resource.data.bookmarks.size() - 1)
        );
      // Incremento/decremento de commentsCount por qualquer usuário autenticado (somente ±1)
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
        && (request.resource.data.commentsCount == resource.data.commentsCount + 1
            || request.resource.data.commentsCount == resource.data.commentsCount - 1);
      // Qualquer autenticado pode incrementar views (somente o campo views)
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      // Votação em enquete: qualquer autenticado pode modificar o campo poll (votes arrays)
      allow update: if request.auth != null
        && resource.data.get('poll', null) != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll']);
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      // Admin da comunidade pode fixar/desafixar post (apenas campo isPinned)
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned'])
        && resource.data.communityId != null
        && get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.createdBy == request.auth.uid;

      // Comentários (subcollection)
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null
          && (resource.data.authorId == request.auth.uid
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
      }
    }

    // ── Amizades ─────────────────────────────────────────────────
    match /friendships/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.users;
    }

    // ── Solicitações de amizade ──────────────────────────────────
    match /friend_requests/{docId} {
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid);
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid);
    }

    // ── Comunidades ──────────────────────────────────────────────
    match /communities/{commId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['membersCount']));
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // ── Membros de comunidades ───────────────────────────────────
    match /community_members/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      // Próprio membro pode sair OU admin da comunidade pode remover
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.createdBy == request.auth.uid);
    }

    // ── Recados (scraps) ─────────────────────────────────────────
    match /scraps/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && (
          (request.auth.uid in request.resource.data.likes
           && !(request.auth.uid in resource.data.get('likes', []))
           && request.resource.data.likes.size() == resource.data.get('likes',[]).size() + 1)
          ||
          (!(request.auth.uid in request.resource.data.likes)
           && request.auth.uid in resource.data.get('likes', [])
           && request.resource.data.likes.size() == resource.data.get('likes',[]).size() - 1)
        );
      allow delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
    }

    // ── Notificações ─────────────────────────────────────────────
    match /notifications/{uid}/items/{notifId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == uid;
    }

    // ── Bookmarks ─────────────────────────────────────────────────
    match /bookmarks/{uid}/posts/{postId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Stories (24h) ─────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ── Denúncias ─────────────────────────────────────────────────
    match /reports/{docId} {
      allow create: if request.auth != null
        && request.resource.data.reportedBy == request.auth.uid;
      // Somente usuários com isAdmin:true no doc de usuário podem ler/atualizar
      allow read, update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── Highlights (story permanentes no perfil) ─────────────────
    match /highlights/{uid}/items/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Depoimentos (testimonials) ────────────────────────────────
    match /testimonials/{uid}/items/{itemId} {
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow read: if request.auth != null
        && (request.auth.uid == uid || resource.data.status == 'approved');
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null
        && (request.auth.uid == uid || resource.data.fromUid == request.auth.uid);
    }

    // ── Visitas ao perfil ─────────────────────────────────────────
    match /profile_views/{uid}/visitors/{visitorUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == visitorUid;
    }

    // ── Salas de áudio ────────────────────────────────────────────
    match /audio_rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.hostUid == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['participantCount', 'status']));
      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;

      match /participants/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Perguntas anônimas ────────────────────────────────────────
    match /questions/{uid}/items/{itemId} {
      // Dono lê tudo; outros leem apenas respondidas
      allow read: if request.auth != null
        && (request.auth.uid == uid || resource.data.status == 'answered');
      // Qualquer autenticado pode enviar
      allow create: if request.auth != null;
      // Dono responde / apaga; outros podem curtir
      allow update: if request.auth != null
        && (request.auth.uid == uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── Coleções de salvos ────────────────────────────────────────
    match /bookmark_collections/{uid}/colls/{collId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Notas / Status breve ─────────────────────────────────────
    match /notes/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Galeria de fotos ─────────────────────────────────────────
    match /photos/{photoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ── Lives (transmissões ao vivo) ──────────────────────────────
    match /lives/{liveId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.hostUid == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount']));
      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;

      match /messages/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Eventos ───────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if request.auth != null
        && (resource.data.get('privacy', 'public') in ['public', 'friends']
            || resource.data.createdBy == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasAny(['attendees', 'interested']));
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // ── Conversas diretas ────────────────────────────────────────
    match /conversations/{convId} {
      // Criar nova conversa
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      // Ler: participante OU documento ainda não existe (necessário para checar antes de criar)
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);
      // Atualizar: somente participantes; deletedFor só pode adicionar o próprio UID
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if false; // soft delete via deletedFor[]

      // Mensagens (subcollection)
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow update: if request.auth != null
          && resource.data.senderId == request.auth.uid;
        // Qualquer participante pode reagir (atualiza apenas reactions.*)
        allow update: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if request.auth != null
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
