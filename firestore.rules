rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Usuários ─────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Posts ────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likes', 'commentsCount']));
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;

      // Comentários (subcollection)
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid;
      }
    }

    // ── Amizades ─────────────────────────────────────────────────
    match /friendships/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.users;
    }

    // ── Solicitações de amizade ──────────────────────────────────
    match /friend_requests/{docId} {
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid);
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid);
    }

    // ── Comunidades ──────────────────────────────────────────────
    match /communities/{commId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['membersCount']));
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // ── Membros de comunidades ───────────────────────────────────
    match /community_members/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ── Recados (scraps) ─────────────────────────────────────────
    match /scraps/{docId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
    }

    // ── Notificações ─────────────────────────────────────────────
    match /notifications/{uid}/items/{notifId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == uid;
    }

    // ── Bookmarks ─────────────────────────────────────────────────
    match /bookmarks/{uid}/posts/{postId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Conversas diretas ────────────────────────────────────────
    match /conversations/{convId} {
      // Criar nova conversa
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      // Ler/atualizar apenas participantes
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      // Mensagens (subcollection)
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow update, delete: if request.auth != null
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
