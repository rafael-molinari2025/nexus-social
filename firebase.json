{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "*.zip",
      "**/node_modules/**",
      ".firebase/**",
      "nexus/**",
      "audit-report.md",
      "package.json",
      "package-lock.json",
      ".eslintrc.json",
      "eslint.config.js",
      "stylelint.config.js"
    ],
    "rewrites": [
      {
        "source": "/pages/login",
        "destination": "/pages/login.html"
      },
      {
        "source": "/pages/feed",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "404": "/404.html"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}

