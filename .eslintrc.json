{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "globals": {
    "firebase": "readonly",
    "auth": "readonly",
    "db": "readonly",
    "storage": "readonly",
    "googleProvider": "readonly",
    "module": "readonly"
  },
  "rules": {
    "no-undef": "off",
    "no-unused-vars": "off"
  }
}
