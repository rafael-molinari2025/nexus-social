rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars: leitura pública, escrita apenas pelo próprio usuário
    match /avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Imagens de posts: leitura pública, escrita pelo autor autenticado
    match /posts/{uid}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
